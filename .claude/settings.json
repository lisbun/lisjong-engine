{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(python -m ruff format --check *)",
      "Bash(python -m ruff check *)",
      "Bash(python -m unittest *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git fetch *)",
      "PowerShell(python -m ruff format --check *)",
      "PowerShell(python -m ruff check *)",
      "PowerShell(python -m unittest *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)"
    ],
    "ask": [
      "Bash(git push * --force*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch -C *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)",
      "Bash(aws *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch --delete *)",
      "PowerShell(git branch -f *)",
      "PowerShell(git branch --force *)",
      "PowerShell(git switch --discard-changes *)",
      "PowerShell(git switch -f *)",
      "PowerShell(git switch --force *)",
      "PowerShell(git switch -C *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh issue close *)",
      "PowerShell(aws *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git -* push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git -* push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git -* commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git -* commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "PowerShell(gh pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "Bash(gh -* pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "PowerShell(gh -* pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          }
        ]
      }
    ]
  }
}
