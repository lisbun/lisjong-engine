{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git -* push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git -* push *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "direct-main-push"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git -* commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(git -* commit *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git_global_option_guard.py",
              "commit-artifacts"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "PowerShell(gh pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "Bash(gh -* pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          },
          {
            "type": "command",
            "if": "PowerShell(gh -* pr create *)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow_guard.py",
              "pre-pr"
            ],
            "timeout": 120,
            "statusMessage": "Running lisjong-engine pre-PR checks"
          }
        ]
      }
    ]
  }
}
